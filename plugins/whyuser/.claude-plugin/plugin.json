{
  "name": "whyuser",
  "displayName": "WhyUser",
  "version": "1.1.0",
  "description": "Connects WhyUser's MCP server and runs WhyUser workflows, such as Content Revise.",
  "author": {
    "name": "WhyUser",
    "url": "https://whyuser.com"
  },
  "homepage": "https://github.com/WhyUserLabs/skills",
  "repository": "https://github.com/WhyUserLabs/skills",
  "license": "Apache-2.0",
  "keywords": [
    "whyuser",
    "mcp",
    "workflows",
    "buying-committee",
    "content"
  ],
  "mcpServers": {
    "whyuser": {
      "type": "http",
      "url": "https://mcp.whyuser.com/mcp",
      "headers": {
        "Authorization": "Bearer ${user_config.whyuser_mcp_key}"
      }
    }
  },
  "userConfig": {
    "whyuser_mcp_key": {
      "type": "string",
      "title": "WhyUser MCP key",
      "description": "Create one in WhyUser under Settings → AI assistant access → New key. It starts with wu-mcp-.",
      "required": true,
      "sensitive": true
    }
  }
}
